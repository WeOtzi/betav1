# Valentina starts with npm run dev:safe. This gateway uses only fictional data.
# Do not copy another user's .env, SSH credentials or Codex profile.
HOST=127.0.0.1
PORT=4647
NODE_ENV=development
NGROK_AUTOSTART=false
AUDIT_REGISTRATION_OPEN=false
# Full backend development requires a separate Supabase project authorized by Isai.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_URL=
# Shared secret the Instagram DM automation sends as X-Weotzi-Webhook-Token to
# POST /api/instagram-verification/inbound. Empty = falls back to the
# app_settings row n8n_webhook_secret, and then to N8N_WEBHOOK_SECRET.
IG_VERIFY_WEBHOOK_SECRET=
SUPPORT_CHAT_ENABLED=false
# Google Calendar para artistas (OAuth 2.0, ronda 3b). Sin estas variables los
# endpoints /api/google-calendar/* responden 503 y la UI muestra "no disponible".
# Cliente OAuth "Aplicación web" de Google Cloud Console (ver deployments/DEPLOY.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Default: https://beta.weotzi.com/api/google-calendar/callback (debe coincidir
# EXACTO con el URI autorizado en el cliente OAuth).
GOOGLE_OAUTH_REDIRECT_URI=
# 32 bytes aleatorios en base64 (AES-256-GCM de los refresh tokens):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o cambia, todos los artistas tienen que volver a conectar.
GCAL_TOKEN_ENC_KEY=
# Job de sincronización cada 15 min (on por defecto). "off" lo apaga.
GCAL_SYNC_JOB=
# Cifrado de datos sensibles (ronda 3c): números de cuenta de los destinos de
# retiro y apify_token, AES-256-GCM en el servidor (lib/field-crypto.js).
# 32 bytes aleatorios en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin ella, alta/edición de destinos y "ver número completo" responden 503; el
# resto del servidor funciona. Si se PIERDE, los datos cifrados no se recuperan:
# guardala también fuera del servidor (gestor de secretos del dueño).
DATA_ENC_KEY=
# Id de la clave primaria (va dentro de cada valor cifrado). Default: k1.
DATA_ENC_KEY_ID=
# Rotación: claves anteriores, solo para descifrar. "k1=<base64>,k0=<base64>".
# Tras rotar y correr scripts/encrypt-existing-data.cjs --apply, se pueden quitar.
DATA_ENC_PREVIOUS_KEYS=

# ── privacidad ── Microsoft Clarity (opcional). Respaldo si el backoffice
# (Cookies y privacidad) no tiene ID. Solo se carga con consentimiento analítico.
CLARITY_PROJECT_ID=
