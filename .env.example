# Valentina starts with npm run dev:safe. This gateway uses only fictional data.
# Do not copy another user's .env, SSH credentials or Codex profile.
HOST=127.0.0.1
PORT=4647
NODE_ENV=development
NGROK_AUTOSTART=false
AUDIT_REGISTRATION_OPEN=false
# Full backend development requires a separate Supabase project authorized by Isai.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_URL=
# Shared secret the Instagram DM automation sends as X-Weotzi-Webhook-Token to
# POST /api/instagram-verification/inbound. Empty = falls back to the
# app_settings row n8n_webhook_secret, and then to N8N_WEBHOOK_SECRET.
IG_VERIFY_WEBHOOK_SECRET=
SUPPORT_CHAT_ENABLED=false
# Google Calendar para artistas (OAuth 2.0, ronda 3b). Sin estas variables los
# endpoints /api/google-calendar/* responden 503 y la UI muestra "no disponible".
# Cliente OAuth "Aplicación web" de Google Cloud Console (ver deployments/DEPLOY.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Default: https://beta.weotzi.com/api/google-calendar/callback (debe coincidir
# EXACTO con el URI autorizado en el cliente OAuth).
GOOGLE_OAUTH_REDIRECT_URI=
# 32 bytes aleatorios en base64 (AES-256-GCM de los refresh tokens):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o cambia, todos los artistas tienen que volver a conectar.
GCAL_TOKEN_ENC_KEY=
# Job de sincronización cada 15 min (on por defecto). "off" lo apaga.
GCAL_SYNC_JOB=
# Cada cuántos ms se publican los cambios que marcó la base (dirty_at).
# Vacío = 30000; 0 lo apaga (queda el job de 15 min).
GCAL_DIRTY_POLL_MS=
# Cifrado de datos sensibles (ronda 3c): números de cuenta de los destinos de
# retiro y apify_token, AES-256-GCM en el servidor (lib/field-crypto.js).
# 32 bytes aleatorios en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin ella, alta/edición de destinos y "ver número completo" responden 503; el
# resto del servidor funciona. Si se PIERDE, los datos cifrados no se recuperan:
# guardala también fuera del servidor (gestor de secretos del dueño).
DATA_ENC_KEY=
# Id de la clave primaria (va dentro de cada valor cifrado). Default: k1.
DATA_ENC_KEY_ID=
# Rotación: claves anteriores, solo para descifrar. "k1=<base64>,k0=<base64>".
# Tras rotar y correr scripts/encrypt-existing-data.cjs --apply, se pueden quitar.
DATA_ENC_PREVIOUS_KEYS=

# ── privacidad ── Microsoft Clarity (opcional). Respaldo si el backoffice
# (Cookies y privacidad) no tiene ID. Solo se carga con consentimiento analítico.
CLARITY_PROJECT_ID=

# ── emails ── Base de los links de los correos (obligatoria en beta).
# Sin ella el servidor usa https://beta.weotzi.com (nunca el header Host).
PUBLIC_APP_URL=
# Copia de disputas y reply_to de los correos del relé.
SUPPORT_EMAIL=
# Relé genérico de n8n (canal smtp_relay: el servidor manda to/subject/html/text
# ya renderizados). Contrato en docs/N8N_EMAIL_WEBHOOKS.md. Header de auth:
# X-Weotzi-Webhook-Token = N8N_EMAIL_RELAY_TOKEN (o N8N_WEBHOOK_SECRET).
N8N_EMAIL_RELAY_URL=
N8N_EMAIL_RELAY_TOKEN=
N8N_WEBHOOK_SECRET=
# Canal por defecto de los correos (n8n | smtp_relay | billionmail | dual | off).
EMAIL_DEFAULT_CHANNEL=
# Opcional: copia al admin de cada solicitud nueva cuando sale por el relé.
QUOTATION_ADMIN_EMAIL=
# Recordatorio de sesión 24 h (on cada 30 min por defecto; "off" lo apaga).
SESSION_REMINDERS_JOB=

# ── push ── Avisos push (Web Push con VAPID, sin dependencias: lib/web-push.js).
# Generar el par UNA vez y pegar las tres líneas que imprime:
#   node scripts/generate-vapid-keys.js mailto:soporte@weotzi.com
# Sin estas claves el push queda apagado en silencio (GET /api/push/config
# responde enabled=false); los avisos dentro de la app (toast + sonido) y el
# resto del servidor siguen funcionando. La privada es secreta: solo en .env.
# Si se cambian, cada navegador se vuelve a suscribir solo al abrir la app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que ven los servicios push (mailto:… o https://…). Vacío:
# mailto:SUPPORT_EMAIL o, si tampoco está, PUBLIC_APP_URL.
VAPID_SUBJECT=
# Opcional: hosts extra de servicios push permitidos (coma). Por defecto solo
# Chrome/Edge/Opera (FCM), Firefox (Mozilla), Edge en Windows (WNS) y Safari (Apple).
PUSH_ALLOWED_HOSTS=

# ── acceso ── Bienvenida automática (POST /api/account/welcome). Solo reciben
# el correo las cuentas creadas después de esta fecha (ISO 8601) y con menos de
# WELCOME_EMAIL_MAX_AGE_DAYS días. Evita bienvenidas masivas a cuentas viejas.
# Default: 2026-11-15T00:00:00Z y 30 días.
WELCOME_EMAIL_CUTOFF=
WELCOME_EMAIL_MAX_AGE_DAYS=

# ── ia de imágenes ── Generación de imágenes con IA (lib/ai-image.js): referencia
# del cotizador, avatar del artista, "Inspirarme con AI" del Job Board e íconos
# del backoffice. Proveedor: OpenAI con GPT Image 2.6. Sin clave, los endpoints
# responden 503 y el cotizador no muestra "Generar referencia con IA".
# La organización de OpenAI puede necesitar verificación para usar los modelos
# GPT Image (sin ella la API responde 403). Esta misma clave la usa el chat de
# soporte (SUPPORT_CHAT_ENABLED). Es secreta: solo en .env.
OPENAI_API_KEY=
# Proveedor. Vacío = openai. "gemini" usa el proveedor heredado (necesita
# GEMINI_API_KEY; esa clave sola no lo activa); "off" apaga las imágenes con IA
# aunque haya claves.
AI_IMAGE_PROVIDER=
# Modelo general: gpt-image-2.6-flare (default, rápido) o gpt-image-2.6-sunburst
# (trabajo detallado). Un valor desconocido cae al default.
AI_IMAGE_MODEL=
# Modelo de la referencia con IA del cotizador (mismos valores). Vacío o
# desconocido = AI_IMAGE_MODEL.
AI_REFERENCE_MODEL=
# Calidad: low | medium | high. Default: medium. Más calidad = más costo y espera.
AI_IMAGE_QUALITY=
# Espera máxima al proveedor, en ms. Default: 120000 (máximo 280000). Tiene que
# ser MENOR que la espera del proxy PHP para estas rutas: 150 s con el proxy del
# repo (deployments/hostinger/proxy.php). Si el proxy instalado todavía corta a
# los 60 s, usar 55000. Ver "Alta", paso 3, en deployments/DEPLOY.md.
AI_IMAGE_TIMEOUT_MS=
# Topes diarios del proceso: cotizador (default 300) y endpoint genérico
# (default 500; GEMINI_DAILY_CAP sigue valiendo como alias).
AI_REFERENCE_DAILY_CAP=
AI_IMAGE_DAILY_CAP=
# Proveedor heredado: solo se usa con AI_IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=
