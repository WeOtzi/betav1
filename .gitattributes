# Preserve shell scripts for the Linux controller and avoid treating PDFs as text.
*.sh text eol=lf
*.pdf binary

# Preserve vendored asset bytes and their upstream checksums on Windows.
scripts/release/preview-assets/** -text

# Migraciones SQL siempre con LF (los tests las leen como texto; COT-A-16).
*.sql text eol=lf

# Archivos que se copian tal cual al VPS de beta (Linux): siempre LF.
deployments/vps/** text eol=lf
